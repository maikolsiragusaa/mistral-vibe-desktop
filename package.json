{
  "name": "vibe-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "A community Windows workspace for the official Mistral Vibe engine",
  "author": "Vibe Desktop contributors",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.*",
    "test:backend": "node --test tests/backend.test.*",
    "test:ui": "playwright test",
    "package": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:dir": "npm run build && electron-builder --win dir --x64 --publish never"
  },
  "dependencies": {
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "5.1.0"
    }
  },
  "build": {
    "appId": "community.vibe.desktop",
    "productName": "Vibe Desktop",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "package.json",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": ".runtime/backend/vibe-app-server",
        "to": "backend/vibe-app-server"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "artifactName": "Vibe-Desktop-${version}-${arch}-Setup.${ext}"
  }
}
